      "definition": "CHECK (((status)::text = ANY ((ARRAY['PENDING'::character varying, 'APPROVED'::character varying, 'REJECTED'::character varying, 'CANCELLED'::character varying, 'STALE'::character varying])::text[])))"
    },
    {
      "table_name": "approval_requests",
      "conname": "approval_requests_check",
      "definition": "CHECK (((reviewed_by IS NULL) OR (reviewed_by <> requested_by)))"
    },
    {
      "table_name": "approval_requests",
      "conname": "approval_requests_check1",
      "definition": "CHECK ((((status)::text <> ALL ((ARRAY['APPROVED'::character varying, 'REJECTED'::character varying])::text[])) OR ((reviewed_by IS NOT NULL) AND (reviewed_at IS NOT NULL))))"
